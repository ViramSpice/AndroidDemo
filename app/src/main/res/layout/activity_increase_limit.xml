<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background_gray">

    <!-- Status bar space -->
    <View
        android:id="@+id/status_bar_space"
        android:layout_width="0dp"
        android:layout_height="24dp"
        android:background="@color/primary_blue"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Header toolbar -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/header_toolbar"
        android:layout_width="0dp"
        android:layout_height="56dp"
        android:background="@color/primary_blue"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        app:layout_constraintTop_toBottomOf="@id/status_bar_space"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <!-- Back arrow -->
        <ImageView
            android:id="@+id/btn_back"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:src="@drawable/ic_arrow_back"
            android:contentDescription="Back"
            app:tint="@color/white"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent" />

        <!-- Title -->
        <TextView
            android:id="@+id/tv_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:layout_marginEnd="16dp"
            android:text="Increase Wallet Limit"
            android:textColor="@color/white"
            android:textSize="18sp"
            android:textStyle="bold"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toEndOf="@id/btn_back"
            app:layout_constraintEnd_toStartOf="@id/tv_time" />

        <!-- Time -->
        <TextView
            android:id="@+id/tv_time"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="12:30"
            android:textColor="@color/white"
            android:textSize="14sp"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

    </androidx.constraintlayout.widget.ConstraintLayout>

    <!-- Red accent line -->
    <View
        android:id="@+id/accent_line"
        android:layout_width="0dp"
        android:layout_height="4dp"
        android:background="@color/accent_red"
        app:layout_constraintTop_toBottomOf="@id/header_toolbar"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Main content background -->
    <View
        android:id="@+id/content_background"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:background="@color/white"
        app:layout_constraintTop_toBottomOf="@id/accent_line"
        app:layout_constraintBottom_toTopOf="@id/btn_back_to_home"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Illustration -->
    <ImageView
        android:id="@+id/iv_illustration"
        android:layout_width="200dp"
        android:layout_height="160dp"
        android:src="@drawable/ic_document_review"
        android:contentDescription="Document review illustration"
        app:layout_constraintTop_toBottomOf="@id/accent_line"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="32dp" />

    <!-- Dear Customer text -->
    <TextView
        android:id="@+id/tv_dear_customer"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Dear Customer"
        android:textColor="@color/text_dark"
        android:textSize="20sp"
        android:textStyle="bold"
        android:layout_marginTop="32dp"
        app:layout_constraintTop_toBottomOf="@id/iv_illustration"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Main message -->
    <TextView
        android:id="@+id/tv_main_message"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="Your request is submitted successfully and is under review"
        android:textColor="@color/text_dark"
        android:textSize="18sp"
        android:textAlign="center"
        android:lineSpacingExtra="4dp"
        android:layout_marginTop="16dp"
        android:layout_marginStart="32dp"
        android:layout_marginEnd="32dp"
        app:layout_constraintTop_toBottomOf="@id/tv_dear_customer"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Notification message -->
    <TextView
        android:id="@+id/tv_notification"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="We'll notify you about the status within 3 working days"
        android:textColor="@color/text_medium"
        android:textSize="14sp"
        android:textAlign="center"
        android:layout_marginTop="24dp"
        android:layout_marginStart="32dp"
        android:layout_marginEnd="32dp"
        app:layout_constraintTop_toBottomOf="@id/tv_main_message"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Progress Timeline Container -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/timeline_container"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="40dp"
        android:layout_marginStart="32dp"
        android:layout_marginEnd="32dp"
        app:layout_constraintTop_toBottomOf="@id/tv_notification"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <!-- Step 1: Request Submitted -->
        <ImageView
            android:id="@+id/iv_step1_icon"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:src="@drawable/ic_check_circle"
            app:tint="@color/success_green"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toStartOf="@id/progress_line1"
            app:layout_constraintHorizontal_chainStyle="spread" />

        <TextView
            android:id="@+id/tv_step1_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="Request\nSubmitted"
            android:textColor="@color/text_dark"
            android:textSize="12sp"
            android:textAlign="center"
            android:textStyle="bold"
            android:layout_marginTop="8dp"
            app:layout_constraintTop_toBottomOf="@id/iv_step1_icon"
            app:layout_constraintStart_toStartOf="@id/iv_step1_icon"
            app:layout_constraintEnd_toEndOf="@id/iv_step1_icon" />

        <TextView
            android:id="@+id/tv_step1_date"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="13 Mar 2025"
            android:textColor="@color/text_light"
            android:textSize="11sp"
            android:textAlign="center"
            android:layout_marginTop="4dp"
            app:layout_constraintTop_toBottomOf="@id/tv_step1_title"
            app:layout_constraintStart_toStartOf="@id/iv_step1_icon"
            app:layout_constraintEnd_toEndOf="@id/iv_step1_icon" />

        <!-- Progress line 1 -->
        <View
            android:id="@+id/progress_line1"
            android:layout_width="0dp"
            android:layout_height="2dp"
            android:background="@color/success_green"
            app:layout_constraintTop_toTopOf="@id/iv_step1_icon"
            app:layout_constraintBottom_toBottomOf="@id/iv_step1_icon"
            app:layout_constraintStart_toEndOf="@id/iv_step1_icon"
            app:layout_constraintEnd_toStartOf="@id/iv_step2_icon"
            android:layout_marginStart="16dp"
            android:layout_marginEnd="16dp" />

        <!-- Step 2: Request Under Review -->
        <ImageView
            android:id="@+id/iv_step2_icon"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:src="@drawable/ic_check_circle"
            app:tint="@color/success_green"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toEndOf="@id/progress_line1"
            app:layout_constraintEnd_toStartOf="@id/progress_line2" />

        <TextView
            android:id="@+id/tv_step2_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="Request Under\nReview"
            android:textColor="@color/text_dark"
            android:textSize="12sp"
            android:textAlign="center"
            android:textStyle="bold"
            android:layout_marginTop="8dp"
            app:layout_constraintTop_toBottomOf="@id/iv_step2_icon"
            app:layout_constraintStart_toStartOf="@id/iv_step2_icon"
            app:layout_constraintEnd_toEndOf="@id/iv_step2_icon" />

        <TextView
            android:id="@+id/tv_step2_date"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="13 Mar 2025"
            android:textColor="@color/text_light"
            android:textSize="11sp"
            android:textAlign="center"
            android:layout_marginTop="4dp"
            app:layout_constraintTop_toBottomOf="@id/tv_step2_title"
            app:layout_constraintStart_toStartOf="@id/iv_step2_icon"
            app:layout_constraintEnd_toEndOf="@id/iv_step2_icon" />

        <!-- Progress line 2 -->
        <View
            android:id="@+id/progress_line2"
            android:layout_width="0dp"
            android:layout_height="2dp"
            android:background="@color/progress_gray"
            app:layout_constraintTop_toTopOf="@id/iv_step2_icon"
            app:layout_constraintBottom_toBottomOf="@id/iv_step2_icon"
            app:layout_constraintStart_toEndOf="@id/iv_step2_icon"
            app:layout_constraintEnd_toStartOf="@id/iv_step3_icon"
            android:layout_marginStart="16dp"
            android:layout_marginEnd="16dp" />

        <!-- Step 3: Request Status -->
        <ImageView
            android:id="@+id/iv_step3_icon"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:src="@drawable/ic_pending_circle"
            app:tint="@color/progress_gray"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toEndOf="@id/progress_line2"
            app:layout_constraintEnd_toEndOf="parent" />

        <TextView
            android:id="@+id/tv_step3_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="Request\nStatus"
            android:textColor="@color/text_medium"
            android:textSize="12sp"
            android:textAlign="center"
            android:layout_marginTop="8dp"
            app:layout_constraintTop_toBottomOf="@id/iv_step3_icon"
            app:layout_constraintStart_toStartOf="@id/iv_step3_icon"
            app:layout_constraintEnd_toEndOf="@id/iv_step3_icon" />

        <TextView
            android:id="@+id/tv_step3_date"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="Pending"
            android:textColor="@color/text_light"
            android:textSize="11sp"
            android:textAlign="center"
            android:layout_marginTop="4dp"
            app:layout_constraintTop_toBottomOf="@id/tv_step3_title"
            app:layout_constraintStart_toStartOf="@id/iv_step3_icon"
            app:layout_constraintEnd_toEndOf="@id/iv_step3_icon" />

        <!-- Chain setup for equal distribution -->
        <androidx.constraintlayout.widget.Group
            android:id="@+id/timeline_chain"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:constraint_referenced_ids="iv_step1_icon,iv_step2_icon,iv_step3_icon" />

    </androidx.constraintlayout.widget.ConstraintLayout>

    <!-- Back to Home button -->
    <Button
        android:id="@+id/btn_back_to_home"
        android:layout_width="0dp"
        android:layout_height="48dp"
        android:text="Back to Home"
        android:textColor="@color/white"
        android:textSize="16sp"
        android:textStyle="bold"
        android:background="@drawable/button_primary"
        android:elevation="2dp"
        android:layout_margin="16dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>